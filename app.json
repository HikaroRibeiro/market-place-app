{
  "expo": {
    "name": "market-place-app",
    "slug": "market-place-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "marketplace",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.marketplaceapp",
      "supportsTablet": true,
      "icon": "./assets/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.marketplaceapp",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/web/favicon.ico",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
        [
          "expo-image-picker",
          {
            "photosPermission": "The app accesses your photos to let you share them with your friends.",
            "cameraPermission": "The app accesses your camera to let you share them with your friends."
          }
        ]
    ]
  }
}
